# API base URL.
# Use a full backend URL if the API is hosted separately.
# Example: VITE_APP_API_URL=https://api.example.com/api
#
# If the frontend and backend are served behind the same domain/proxy,
# you can keep this as a relative path.
# VITE_APP_API_URL=/api
#
# Map provider configuration for the admin property map.
# Supported values: osm, google, mapbox
# VITE_MAP_PROVIDER=osm
# VITE_GOOGLE_MAPS_API_KEY=
# VITE_MAPBOX_TOKEN=
